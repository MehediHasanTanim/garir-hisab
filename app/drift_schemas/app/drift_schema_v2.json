          "sql": "CREATE TABLE IF NOT EXISTS \"vehicles\" (\"id\" TEXT NOT NULL, \"owner_id\" TEXT NOT NULL DEFAULT 'local', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"rev\" INTEGER NOT NULL DEFAULT 0, \"dirty\" INTEGER NOT NULL DEFAULT 1 CHECK (\"dirty\" IN (0, 1)), \"nickname\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"reg_no\" TEXT NULL, \"reg_no_key\" TEXT NULL, \"model\" TEXT NULL, \"year\" INTEGER NULL, \"fuel_type\" TEXT NOT NULL, \"business_model\" TEXT NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'active', \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"photo_file\" TEXT NULL, \"purchase_date\" INTEGER NULL, \"purchase_price_minor\" INTEGER NULL, PRIMARY KEY (\"id\"));"
