      "name": "audit_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"audit_logs\" (\"id\" TEXT NOT NULL, \"owner_id\" TEXT NOT NULL DEFAULT 'local', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"rev\" INTEGER NOT NULL DEFAULT 0, \"dirty\" INTEGER NOT NULL DEFAULT 1 CHECK (\"dirty\" IN (0, 1)), \"entity\" TEXT NOT NULL, \"entity_id\" TEXT NOT NULL, \"action\" TEXT NOT NULL, \"diff_json\" TEXT NOT NULL DEFAULT '{}', \"at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
